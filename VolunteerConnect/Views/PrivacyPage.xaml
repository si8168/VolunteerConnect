<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VolunteerConnect.Views.OpportunityDetailsPage"
             Title="Opportunity Details">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15" MaximumWidthRequest="600" HorizontalOptions="Center">
            <Label x:Name="TitleLabel" FontSize="24" FontAttributes="Bold" TextColor="#512BD4" />
            <Label x:Name="CategoryLabel" FontSize="14" FontAttributes="Bold" TextColor="Gray" />
            
            <Border Padding="15" StrokeThickness="1" Stroke="#E0E0E0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="LocationLabel" FontSize="15" />
                    <Label x:Name="DateLabel" FontSize="15" />
                    <Label x:Name="TimeLabel" FontSize="15" />
                    <Label x:Name="PlacesLabel" FontSize="15" TextColor="Green" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Description" FontSize="18" FontAttributes="Bold" />
            <Label x:Name="DescriptionLabel" FontSize="15" />

            <Label Text="Requirements" FontSize="18" FontAttributes="Bold" />
            <Label x:Name="RequirementsLabel" FontSize="15" />

            <Button Text="Register Interest" Clicked="OnRegisterClicked" Margin="0,15,0,0" HeightRequest="45" BackgroundColor="#512BD4" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>