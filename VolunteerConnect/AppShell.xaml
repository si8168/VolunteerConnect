<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="VolunteerConnect.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:VolunteerConnect.Views"
    Title="VolunteerConnect">

    <TabBar>
        <Tab Title="Home">
            <ShellContent ContentTemplate="{DataTemplate views:HomePage}" />
        </Tab>
        <Tab Title="Opportunities">
            <ShellContent ContentTemplate="{DataTemplate views:OpportunitiesPage}" />
        </Tab>
        <Tab Title="My Registrations">
            <ShellContent ContentTemplate="{DataTemplate views:MyRegistrationsPage}" />
        </Tab>
        <Tab Title="Privacy">
            <ShellContent ContentTemplate="{DataTemplate views:PrivacyPage}" />
        </Tab>
    </TabBar>

</Shell>